<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 内核以 HTTP 监听 127.0.0.1，WebView 从这里加载 UI -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 语音输入：系统 SpeechRecognizer 需要麦克风，运行时再申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 诊断日志导出：仅 API 26-28 直写公共下载目录用；29+ 走 MediaStore 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 内核进程要在后台存活：specialUse（dataSync 在 Android 15+ 有 6 小时/天配额，见 AGENTS P-005） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".CodeForgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeForge"
        android:usesCleartextTraffic="true">

        <!-- launchMode 必须与 onNewIntent 的注释一致：应用在前台点通知也要走
             onNewIntent 而不是叠一个新实例（standard 会新开，deep-link 逻辑失效） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CodeForge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 入站分享：浏览器/微信/相册「分享到 CodeForge」→ 预填输入卡。
                 特意不收 ACTION_VIEW http —— 那会让本应用出现在所有链接的
                 「打开方式」里，用户误设默认后链接全被劫持 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- 长按选中文本 → 「CodeForge」：与分享同一处理通路 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the local AI coding-agent core (localhost HTTP/WebSocket server) for this app" />
        </service>

        <!-- 审批通知的批准/拒绝快操作：经 LiveTransport 走已连的 WS 发决定 -->
        <receiver
            android:name=".core.ApprovalReceiver"
            android:exported="false" />

        <!-- 相机附件：TakePicture 经 FileProvider 出片 URI。
             未声明 CAMERA 权限 —— 走系统相机应用代拍时不需要（声明了反而必须先授权） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
